# Copiar como .env.production en la VPS y completar todos los valores COMPLETAR.
# El archivo real debe tener permisos 600 y nunca se versiona.

# Dominio publico. HTTPS termina en el Nginx instalado en la VPS.
APP_PUBLIC_URL=https://iptvcontrol.com.ar
CORS_ORIGINS=https://iptvcontrol.com.ar
FRONTEND_PORT=8080

# PostgreSQL. Generar cada password con: openssl rand -hex 24
POSTGRES_USER=iptvcontrol
POSTGRES_PASSWORD=COMPLETAR
POSTGRES_DB=iptvcontrol
APP_DB_USER=iptvcontrol_app
APP_DB_PASSWORD=COMPLETAR

# Redis. Generar con: openssl rand -hex 24
REDIS_PASSWORD=COMPLETAR

# AES-256-GCM. Generar con: openssl rand -hex 32
# Guardar una copia segura fuera de la VPS: perderla vuelve ilegibles las credenciales cifradas.
ENCRYPTION_MASTER_KEY=COMPLETAR

# Auth0
AUTH0_DOMAIN=COMPLETAR.us.auth0.com
AUTH0_AUDIENCE=https://api.iptvcontrol.com.ar
AUTH0_ISSUER_URL=https://COMPLETAR.us.auth0.com/
AUTH0_MGMT_CLIENT_ID=COMPLETAR
AUTH0_MGMT_CLIENT_SECRET=COMPLETAR
AUTH0_DB_CONNECTION=Username-Password-Authentication
AUTH0_INVITATION_TTL_SEC=259200

# Frontend: estas variables se incorporan durante el build de Vite.
VITE_API_BASE_URL=/api/v1
VITE_AUTH0_DOMAIN=COMPLETAR.us.auth0.com
VITE_AUTH0_CLIENT_ID=COMPLETAR
VITE_AUTH0_AUDIENCE=https://api.iptvcontrol.com.ar

# Swagger. Si quedan vacias, /api/docs no se publica.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Integracion SENSA. Las credenciales se cargan despues desde el panel.
SENSA_RATE_LIMIT_PER_MINUTE=60
SENSA_REQUEST_TIMEOUT_MS=15000
SENSA_DNI_MAX_RETRIES=25

# Primer operator_admin. El seed crea solamente a Bruno; Leonel se invita luego desde el panel.
SEED_OPERADOR_NOMBRE=TECNOLOGIA ACTIVA S.A.S.
SEED_ROOT_EMAIL=bruno.c@tecnologiaactiva.com.ar
SEED_ROOT_AUTH0_USER_ID=
SEED_DNI_INICIAL_SENSA=30000000

# pgAdmin (opcional, sólo con --profile pgadmin). Atado a 127.0.0.1: se entra
# por túnel SSH, nunca queda publicado en el dominio. Ver docker-compose.prod.yml.
PGADMIN_DEFAULT_EMAIL=COMPLETAR
PGADMIN_DEFAULT_PASSWORD=COMPLETAR
PGADMIN_PORT=5050
