// =============================================================================
// IPTVControl — modelo de datos (PostgreSQL + Prisma)
// =============================================================================
// Nomenclatura en ESPAÑOL, siguiendo el glosario oficial del negocio
// (docs/02_Glosario_de_Actores_y_Entidades.md). La traducción a inglés ocurre
// solo en la capa de presentación del frontend (docs/IPTVControl_URL_Routing_
// Convention.md). No usar la palabra "slot": el nombre oficial es "Dispositivo".
//
// El aislamiento multi-tenant tiene DOS capas:
//   1. Scope por tenant en la capa de aplicación (middleware NestJS).
//   2. Row-Level Security nativo de Postgres (ver migración 0002_rls),
//      apoyado en el ajuste de sesión `app.current_tenant`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Esquema bajo el cual una Empresa Revendedora compra Cuentas al Operador
/// Principal (docs/03_Reglas_de_Negocio.md, sección 1).
enum ModalidadComercialTipo {
  menudeo
  obligacion_mensual
}

enum EstadoEmpresaRevendedora {
  activa
  suspendida
}

/// Los dos métodos de alta de Cliente Final (reglas de negocio, sección 2.1).
enum TipoAltaClienteFinal {
  cuenta_exclusiva
  dispositivo_compartido
}

enum EstadoClienteFinal {
  activo
  suspendido
  dado_de_baja
}

enum EstadoCuenta {
  activa
  cerrada
}

/// Proyección técnica de las categorías del Proveedor. La capacidad comercial
/// de una Cuenta es un máximo global de 3 Dispositivos, sin topes comerciales
/// independientes por categoría.
enum TipoDispositivo {
  fijo
  movil
}

/// `bloqueado_por_suspension`: liberado en SENSA pero reservado, no reasignable
/// mientras el Cliente Final titular siga suspendido (reglas de negocio, 3).
enum EstadoDispositivo {
  activo
  bloqueado_por_suspension
  disponible
  dado_de_baja
}

enum EstadoVinculacionDispositivo {
  pendiente
  observando
  vinculado
  ambiguo
  expirado
  cancelado
}

enum EstadoSolicitudVinculacion {
  pendiente
  observando
  vinculado
  ambiguo
  expirado
  cancelado
}

enum EstadoIncidenciaDispositivo {
  pendiente
  reconocido
  eliminacion_pendiente
  resuelto
}

/// En el MVP solo se usan `operator_admin` y `reseller_admin`; los otros dos
/// quedan reservados a futuro (glosario, "Team Member").
enum RolTeamMember {
  operator_admin
  operator_staff
  reseller_admin
  reseller_staff
}

enum EstadoTeamMember {
  invitado
  activo
  inactivo
}

enum MotivoFinVentanaCuriosidad {
  vencimiento
  levantamiento_manual
  cancelacion_venta
}

/// Origen de una Cuenta. Distingue las creadas por IPTVControl (consumen cupo
/// mensual de creación) de las importadas desde el Proveedor (no lo consumen).
enum CuentaProcedencia {
  creada_en_sistema
  importada_proveedor
}

/// Acciones trazadas en el Audit Log (reglas de negocio, sección 11).
enum AccionAuditoria {
  alta_cliente
  suspension_cliente
  reactivacion_cliente
  baja_cliente
  reasignacion_dispositivo
  alta_dispositivo
  baja_dispositivo
  migracion_cuenta
  alta_cuenta
  cierre_cuenta
  cambio_password_cuenta
  cambio_tipo_cuenta
  cambio_servicios_cuenta
  cambio_modalidad_comercial
  cambio_precio
  alta_empresa_revendedora
  baja_empresa_revendedora
  cambio_configuracion_proveedor
  alta_team_member
  reenvio_invitacion_team_member
  baja_team_member
  apertura_vinculacion_dispositivo
  vinculacion_dispositivo
  vinculacion_ambigua
  alta_reserva_tecnica
  liberacion_reserva_tecnica
  deteccion_dispositivo_no_autorizado
  resolucion_incidencia_dispositivo
  correccion_vinculacion_dispositivo
  apertura_ventana_curiosidad
  levantamiento_ventana_curiosidad
  cambio_configuracion_ventana_curiosidad
  actualizacion_empresa_revendedora
  suspension_empresa_revendedora
  reactivacion_empresa_revendedora
  cambio_slots_cuenta
  cambio_plantilla_whatsapp
}

enum EntidadAuditada {
  ClienteFinal
  Dispositivo
  Cuenta
  EmpresaRevendedora
  ModalidadComercial
  ConfiguracionProveedor
  TeamMember
  SolicitudVinculacionDispositivo
  ReservaTecnicaDispositivo
  IncidenciaDispositivoProveedor
  VentanaCuriosidad
}

enum EstadoLlamadaProveedor {
  exitosa
  fallida
}

// -----------------------------------------------------------------------------
// Actores
// -----------------------------------------------------------------------------

/// Empresa responsable de la infraestructura y titular del contrato con el
/// Proveedor. Tecnología Activa es el primer Operador Principal, pero el modelo
/// admite varios (cada distribuidor que adopte IPTVControl).
model OperadorPrincipal {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @db.VarChar(160)

  /// Proveedor activo (hoy siempre SENSA).
  proveedorActivoId String?    @map("proveedor_activo_id") @db.Uuid
  proveedorActivo   Proveedor? @relation(fields: [proveedorActivoId], references: [id], onDelete: SetNull)

  /// Número inicial parametrizable para generar el identificador tipo DNI que
  /// SENSA exige al crear una Cuenta (reglas de negocio, 2.3).
  dniInicialSensa Int @map("dni_inicial_sensa")

  /// Último DNI efectivamente utilizado. Se incrementa de a 1 por alta de
  /// Cuenta, y también ante error de "DNI repetido" devuelto por SENSA.
  dniActualSensa Int @map("dni_actual_sensa")

  /// Umbral de la alerta de Cuenta cerca del tope (reglas de negocio, 12).
  /// Valor inicial sugerido: 2 de 3. Se deja configurable para no tener que
  /// tocar código si Federico decide otro valor.
  umbralAlertaCapacidad Int @default(2) @map("umbral_alerta_capacidad")

  /// Límite de reintentos ante "DNI repetido" antes de cortar y alertar
  /// (caso límite pendiente de definición formal — docs/05, sección 4).
  maxReintentosDni Int @default(25) @map("max_reintentos_dni")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresasRevendedoras   EmpresaRevendedora[]
  modalidadesComerciales ModalidadComercial[]
  teamMembers            TeamMember[]
  configuraciones        ConfiguracionProveedor[]
  auditLogs              AuditLog[]
  llamadasProveedor      LlamadaProveedor[]

  @@map("operador_principal")
}

/// Plataforma de contenido IPTV sobre la que corre el servicio. Hoy SENSA.
/// `tipoConector` referencia la implementación de ProveedorAdapter a usar.
model Proveedor {
  id           String @id @default(uuid()) @db.Uuid
  nombre       String @unique @db.VarChar(80)
  tipoConector String @map("tipo_conector") @db.VarChar(40)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  operadores      OperadorPrincipal[]
  configuraciones ConfiguracionProveedor[]
  cuentas         Cuenta[]

  @@map("proveedor")
}

/// Credenciales y parámetros de conexión al Proveedor, por Operador Principal.
/// Editable desde el Menú de Parametrización (docs/04, sección 9).
/// El `token` se guarda cifrado con AES-256-GCM y nunca se devuelve en claro.
model ConfiguracionProveedor {
  id String @id @default(uuid()) @db.Uuid

  operadorPrincipalId String            @map("operador_principal_id") @db.Uuid
  operadorPrincipal   OperadorPrincipal @relation(fields: [operadorPrincipalId], references: [id], onDelete: Cascade)

  proveedorId String    @map("proveedor_id") @db.Uuid
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  /// Host de la API del Proveedor (ej. "api.sensa.com").
  server       String @db.VarChar(200)
  /// Puerto de conexión (ej. "443").
  port         Int
  /// Usuario de Basic Auth.
  usuario      String @db.VarChar(120)
  /// Token de Basic Auth, cifrado en base de datos.
  tokenCifrado String @map("token_cifrado")

  /// Parámetros técnicos que la API de SENSA exige al crear una Cuenta y que
  /// no forman parte de los datos de negocio del Cliente Final.
  /// `city` es obligatorio en Add User; `services` define la parametrización
  /// de contenido inicial (ver Anexo de Servicios de la API).
  ciudadPorDefecto    String @default("Mendoza") @map("ciudad_por_defecto") @db.VarChar(80)
  serviciosPorDefecto String @default("1") @map("servicios_por_defecto") @db.VarChar(40)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([operadorPrincipalId, proveedorId])
  @@map("configuracion_proveedor")
}

/// Empresa (típicamente un ISP) que compra Cuentas al Operador Principal para
/// revenderlas a sus Clientes Finales. Es el tenant del sistema.
model EmpresaRevendedora {
  id String @id @default(uuid()) @db.Uuid

  operadorPrincipalId String            @map("operador_principal_id") @db.Uuid
  operadorPrincipal   OperadorPrincipal @relation(fields: [operadorPrincipalId], references: [id], onDelete: Cascade)

  // Datos administrativos/legales (reglas de negocio, sección 14).
  // No se envían al Proveedor.
  razonSocial      String  @map("razon_social") @db.VarChar(160)
  /// CUIT como string de 11 dígitos sin guiones ni espacios, por consistencia
  /// con el campo `cuit` de SENSA (pendiente de confirmar con Federico si se
  /// aplica la misma validación — docs/05, sección 5).
  cuit             String  @unique @db.VarChar(11)
  direccion        String  @db.VarChar(200)
  nombreContacto   String  @map("nombre_contacto") @db.VarChar(80)
  apellidoContacto String  @map("apellido_contacto") @db.VarChar(80)
  telefonoContacto String  @map("telefono_contacto") @db.VarChar(30)
  /// Base para generar los correos de contacto de cada Cuenta (reglas 2.3).
  emailContacto    String  @map("email_contacto") @db.VarChar(160)
  sitioWeb         String? @map("sitio_web") @db.VarChar(200)

  /// Modalidad vigente. Una Empresa Revendedora opera bajo una sola a la vez.
  modalidadComercialId String?             @map("modalidad_comercial_id") @db.Uuid
  modalidadComercial   ModalidadComercial? @relation(fields: [modalidadComercialId], references: [id], onDelete: SetNull)

  /// Momento en que se le asignó la modalidad vigente. Es el inicio del "mes 1"
  /// para las modalidades con obligación mensual (X5/X10). El Operador Principal
  /// puede ajustarlo manualmente al cambiar de escala (docs/04, sección 1).
  modalidadAsignadaEn DateTime? @map("modalidad_asignada_en")

  /// Cuentas máximas que puede crear (o importar) la Empresa Revendedora en un
  /// mes calendario. Parametrizable por empresa; default 10. Se valida al crear
  /// una Cuenta nueva (las importadas no consumen cupo: docs/03, sección 2.4).
  cuentasMaxCrearMensual Int @default(10) @map("cuentas_max_crear_mensual")

  estado EstadoEmpresaRevendedora @default(activa)

  /// Correlativo interno para `numero_cliente` de Clientes Finales.
  secuenciaNumeroCliente Int @default(0) @map("secuencia_numero_cliente")
  /// Correlativo para el sufijo del email de contacto de cada Cuenta
  /// (contacto1@isp.com, contacto2@isp.com, ...).
  secuenciaEmailCuenta   Int @default(0) @map("secuencia_email_cuenta")

  /// Tiempo máximo que una Cuenta compartida queda reservada para clientes ya
  /// existentes después de una venta nueva. La Empresa puede reducirlo en cada alta.
  duracionVentanaCuriosidadMinutos Int @default(0) @map("duracion_ventana_curiosidad_minutos")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  clientesFinales        ClienteFinal[]
  cuentas                Cuenta[]
  ventasCompartidas      VentaCompartida[]
  dispositivos           Dispositivo[]
  solicitudesVinculacion SolicitudVinculacionDispositivo[]
  incidenciasDispositivo IncidenciaDispositivoProveedor[]
  teamMembers            TeamMember[]
  auditLogs              AuditLog[]
  ventanasCuriosidad     VentanaCuriosidad[]
  plantillaWhatsApp      PlantillaWhatsApp?

  @@index([operadorPrincipalId])
  @@map("empresa_revendedora")
}

/// Plantilla de WhatsApp de cada Empresa Revendedora (una por tenant).
/// La Revendedora arma su propio texto de credenciales con tokens; el sistema
/// lo guarda y lo reutiliza al copiar el mensaje para un Cliente Final.
model PlantillaWhatsApp {
  id String @id @default(uuid()) @db.Uuid

  empresaRevendedoraId String             @unique @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  /// Texto con tokens `{{nombre}}`. No se registra el contenido en el Audit
  /// Log (puede contener datos comerciales propios de la empresa).
  contenido String @db.Text

  /// Control optimista: cada guardado incrementa la versión.
  version Int @default(1)

  actualizadoPorTeamMemberId String?     @map("actualizado_por_team_member_id") @db.Uuid
  actualizadoPorTeamMember   TeamMember? @relation("PlantillaWhatsAppActualizadaPor", fields: [actualizadoPorTeamMemberId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("plantilla_whatsapp")
}

/// Usuario que consume el servicio IPTV. No tiene acceso propio al sistema.
model ClienteFinal {
  id String @id @default(uuid()) @db.Uuid

  empresaRevendedoraId String             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  /// Correlativo interno de IPTVControl, por Empresa Revendedora.
  numeroCliente Int @map("numero_cliente")

  /// ID del cliente en el sistema de gestión propio de la Empresa Revendedora
  /// (CRM/facturación externa). Opcional; se valida contra duplicados dentro
  /// de la misma Empresa Revendedora, sin bloquear el alta (reglas 2.4).
  idGestionExterno String? @map("id_gestion_externo") @db.VarChar(40)

  nombre   String  @db.VarChar(120)
  apellido String? @db.VarChar(120)

  /// DNI real de la persona (dato administrativo de la Empresa Revendedora).
  /// NO tiene relación con `Cuenta.dniAltaSensa` (identificador sintético
  /// autoincremental que exige SENSA para el alta de la Cuenta) — este campo
  /// nunca se envía al Proveedor, es sólo para uso interno/legal del
  /// Revendedor (ver conversación del 26/08/2026, pedido explícito de Bruno).
  /// Opcional a nivel de base a propósito: producción ya tenía Clientes
  /// Finales cargados sin este dato cuando se agregó (26/08/2026), y un
  /// NOT NULL directo rompió la migración (P3009, corregido 27/08/2026 en
  /// el mismo migration.sql de 20260826140000_agregar_dni_cliente_final,
  /// nunca llegó a aplicarse en producción). El wizard de alta lo sigue
  /// pidiendo como obligatorio para todo Cliente Final nuevo
  /// (`CrearClienteDto.dni`); los históricos quedan en null hasta que
  /// alguien los complete a mano desde el panel.
  dni String? @db.VarChar(20)

  telefono  String? @db.VarChar(30)
  email     String? @db.VarChar(160)
  direccion String? @db.VarChar(200)

  tipoAlta TipoAltaClienteFinal @map("tipo_alta")
  estado   EstadoClienteFinal   @default(activo)

  suspendidoEn DateTime? @map("suspendido_en")
  dadoDeBajaEn DateTime? @map("dado_de_baja_en")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  dispositivos       Dispositivo[]
  ventasCompartidas  VentaCompartida[]
  ventanasCuriosidad VentanaCuriosidad[]
  cuentasExclusivas  Cuenta[]             @relation("ClienteFinalCuentaExclusiva")
  solicitudesVinculacion SolicitudVinculacionDispositivo[] @relation("SolicitudVinculacionClienteFinal")

  @@unique([empresaRevendedoraId, numeroCliente])
  @@index([empresaRevendedoraId, estado])
  @@index([empresaRevendedoraId, idGestionExterno])
  @@map("cliente_final")
}

/// Unidad de contratación entre el Operador Principal y el Proveedor.
/// Capacidad comercial máxima: 3 cupos 1+1 (hasta 3 fijos + 3 móviles). Es la
/// unidad que se factura del Operador Principal a la Empresa Revendedora.
model Cuenta {
  id String @id @default(uuid()) @db.Uuid

  empresaRevendedoraId String             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  proveedorId String    @map("proveedor_id") @db.Uuid
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  /// ID de la Cuenta en el Proveedor. En SENSA es el `customer_id`, que
  /// coincide con el DNI generado internamente.
  proveedorCuentaId String? @map("proveedor_cuenta_id") @db.VarChar(60)

  /// Identificador tipo DNI generado por IPTVControl para el alta en SENSA.
  /// No es un DNI real de una persona física (reglas de negocio, 2.3).
  dniAltaSensa String @unique @map("dni_alta_sensa") @db.VarChar(12)

  usuario         String @db.VarChar(120)
  /// Credenciales de la Cuenta en el Proveedor, cifradas con AES-256-GCM.
  /// Puede quedar pendiente al importar una Cuenta preexistente del Proveedor,
  /// porque SENSA no permite recuperar su contraseña actual.
  passwordCifrado String? @map("password_cifrado")
  pinCifrado      String @map("pin_cifrado")

  /// Correo derivado del email de la Empresa Revendedora + número creciente.
  emailContacto String @unique @map("email_contacto") @db.VarChar(180)

  /// true si fue creada para un único Cliente Final vía "cuenta exclusiva".
  esExclusiva Boolean @default(false) @map("es_exclusiva")

  /// Titular explícito de una Cuenta exclusiva. No se infiere desde los
  /// Dispositivos porque una Cuenta puede tener cliente antes del primer login.
  clienteFinalExclusivoId String?       @map("cliente_final_exclusivo_id") @db.Uuid
  clienteFinalExclusivo   ClienteFinal? @relation("ClienteFinalCuentaExclusiva", fields: [clienteFinalExclusivoId], references: [id], onDelete: SetNull)

  /// Parametrización de contenido vigente en el Proveedor (ej. "1|3|5").
  servicios String @default("1") @db.VarChar(40)

  /// Máximo comercial de cupos por categoría vinculables a la Cuenta.
  limiteDispositivos Int @default(3) @map("limite_dispositivos")

  /// Proyección técnica de la parametrización por categoría del Proveedor.
  /// Se conserva por compatibilidad, pero no define la capacidad comercial.
  dispositivosFijosHabilitados   Int @default(1) @map("dispositivos_fijos_habilitados")
  dispositivosMovilesHabilitados Int @default(1) @map("dispositivos_moviles_habilitados")

  estado EstadoCuenta @default(activa)

  /// Origen de la Cuenta en IPTVControl. Las importadas no consumen el cupo de
  /// creación mensual de la Empresa Revendedora y arrancan como compartidas,
  /// con inventario pendiente de conciliación antes de aceptar ventas nuevas.
  procedencia CuentaProcedencia @default(creada_en_sistema) @map("procedencia")

  /// Para Cuentas importadas del Proveedor: estado de la conciliación inicial
  /// de Dispositivos. Mientras sea `false` la Cuenta no se ofrece para ventas
  /// nuevas ni se ajustan sus contadores (docs/05, sección 4).
  inventarioConciliadoEn DateTime? @map("inventario_conciliado_en")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  dispositivos           Dispositivo[]
  ventasCompartidas      VentaCompartida[]
  solicitudesVinculacion SolicitudVinculacionDispositivo[]
  incidenciasDispositivo IncidenciaDispositivoProveedor[]
  ventanasCuriosidad     VentanaCuriosidad[]

  @@index([empresaRevendedoraId, estado])
  @@index([clienteFinalExclusivoId])
  @@map("cuenta")
}

/// Reserva comercial de cupos entre un Cliente Final y una Cuenta compartida.
/// No se infiere desde los equipos detectados: la venta debe conservar su 1+1
/// o 2+2 aunque el cliente todavía no haya vinculado todos sus Dispositivos.
model VentaCompartida {
  id String @id @default(uuid()) @db.Uuid

  cuentaId String @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  clienteFinalId String       @map("cliente_final_id") @db.Uuid
  clienteFinal   ClienteFinal @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)

  /// Denormalizado para RLS y consultas multi-tenant sin joins.
  empresaRevendedoraId String             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  /// Únicos valores comerciales válidos: 1 (1+1) o 2 (2+2).
  cuposPorCategoria Int @map("cupos_por_categoria")

  creadoEn DateTime @default(now()) @map("creado_en")

  ventanaCuriosidad VentanaCuriosidad?

  @@unique([cuentaId, clienteFinalId])
  @@index([empresaRevendedoraId])
  @@index([cuentaId])
  @@index([clienteFinalId])
  @@map("venta_compartida")
}

/// Restricción local de elegibilidad para nuevas ventas sobre una Cuenta
/// compartida. No modifica capacidad ni contadores del Proveedor.
model VentanaCuriosidad {
  id String @id @default(uuid()) @db.Uuid

  cuentaId String @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  clienteFinalId String       @map("cliente_final_id") @db.Uuid
  clienteFinal   ClienteFinal @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)

  empresaRevendedoraId String             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  ventaCompartidaId String?          @unique @map("venta_compartida_id") @db.Uuid
  ventaCompartida   VentaCompartida? @relation(fields: [ventaCompartidaId], references: [id], onDelete: SetNull)

  inicioEn                      DateTime                    @default(now()) @map("inicio_en")
  duracionPredeterminadaMinutos Int                         @map("duracion_predeterminada_minutos")
  duracionAplicadaMinutos       Int                         @map("duracion_aplicada_minutos")
  finPrevistoEn                 DateTime                    @map("fin_previsto_en")
  finRealEn                     DateTime?                   @map("fin_real_en")
  motivoFin                     MotivoFinVentanaCuriosidad? @map("motivo_fin")

  iniciadaPorTeamMemberId String?     @map("iniciada_por_team_member_id") @db.Uuid
  iniciadaPorTeamMember   TeamMember? @relation("VentanaCuriosidadIniciadaPor", fields: [iniciadaPorTeamMemberId], references: [id], onDelete: SetNull)

  finalizadaPorTeamMemberId String?     @map("finalizada_por_team_member_id") @db.Uuid
  finalizadaPorTeamMember   TeamMember? @relation("VentanaCuriosidadFinalizadaPor", fields: [finalizadaPorTeamMemberId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([empresaRevendedoraId, inicioEn])
  @@index([cuentaId, finRealEn, finPrevistoEn])
  @@index([clienteFinalId])
  @@map("ventana_curiosidad")
}

/// Dispositivo físico (TV o móvil) vinculado a un Cliente Final dentro de una
/// Cuenta. No tiene precio propio en el sistema.
model Dispositivo {
  id String @id @default(uuid()) @db.Uuid

  cuentaId String @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  /// Denormalizado desde la Cuenta para que las políticas de RLS y los
  /// listados filtren por tenant sin joins.
  empresaRevendedoraId String             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  /// null cuando el Dispositivo está `disponible` o `dado_de_baja`. En
  /// `bloqueado_por_suspension` se conserva el titular suspendido, porque el
  /// Dispositivo queda reservado para él.
  clienteFinalId String?       @map("cliente_final_id") @db.Uuid
  clienteFinal   ClienteFinal? @relation(fields: [clienteFinalId], references: [id], onDelete: SetNull)

  /// ID que devuelve el Proveedor al activar. Puede quedar en null hasta que
  /// el dispositivo se registre en SENSA por auto-provisión y el job de
  /// reconciliación lo capture por polling (la API no tiene webhooks).
  proveedorDeviceId String? @map("proveedor_device_id") @db.VarChar(60)

  /// MAC reportada por el Proveedor al detectar el primer inicio de sesión.
  mac String? @db.VarChar(40)

  /// Se completa cuando el sondeo detecta el tipo informado por el Proveedor.
  tipo          TipoDispositivo?
  tipoProveedor String?          @map("tipo_proveedor") @db.VarChar(40)

  estado            EstadoDispositivo            @default(activo)
  estadoVinculacion EstadoVinculacionDispositivo @default(pendiente) @map("estado_vinculacion")

  /// Nota descriptiva libre de la Empresa Revendedora (ej. "TV living").
  /// Dato interno de IPTVControl, NO se envía al Proveedor y NO se expone al
  /// Operador Principal (reglas de negocio, 4.2).
  notaDescriptiva String? @map("nota_descriptiva") @db.VarChar(200)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  solicitudesVinculacion SolicitudVinculacionDispositivo[]

  @@unique([cuentaId, proveedorDeviceId])
  @@index([empresaRevendedoraId, estado])
  @@index([cuentaId, tipo, estado])
  @@index([clienteFinalId])
  @@map("dispositivo")
}

model SolicitudVinculacionDispositivo {
  id String @id @default(uuid()) @db.Uuid

  /// Para una venta compartida la ventana se abre SIN una fila de Dispositivo
  /// previa (Pieza 4): el equipo se materializa recién cuando el Proveedor lo
  /// reporta. `cliente_final_id` identifica al Cliente Final de la venta.
  /// En Cuentas exclusivas (y altas adicionales) la fila existe y `dispositivoId`
  /// la referencia, como antes.
  dispositivoId String?     @map("dispositivo_id") @db.Uuid
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  clienteFinalId String?       @map("cliente_final_id") @db.Uuid
  clienteFinal   ClienteFinal? @relation("SolicitudVinculacionClienteFinal", fields: [clienteFinalId], references: [id], onDelete: SetNull)

  cuentaId String @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  /// Denormalizado para aplicar RLS sin joins.
  empresaRevendedoraId String             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  estado                     EstadoSolicitudVinculacion @default(pendiente)
  baselineDeviceIds          Json                       @map("baseline_device_ids")
  proveedorDeviceIdCandidato String?                    @map("proveedor_device_id_candidato") @db.VarChar(60)
  abiertaEn                  DateTime                   @default(now()) @map("abierta_en")
  expiraEn                   DateTime                   @map("expira_en")
  proximoSondeoEn            DateTime                   @map("proximo_sondeo_en")
  ultimoSondeoEn             DateTime?                  @map("ultimo_sondeo_en")
  cantidadIntentos           Int                        @default(0) @map("cantidad_intentos")
  motivoAmbiguedad           String?                    @map("motivo_ambiguedad") @db.VarChar(300)
  /// Permite liberar la reserva si vence el primer intento de una venta nueva,
  /// sin borrar una venta existente cuando sólo venció un Dispositivo adicional.
  creaVentaCompartida        Boolean                    @default(false) @map("crea_venta_compartida")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([empresaRevendedoraId, estado])
  @@index([cuentaId, estado])
  @@index([proximoSondeoEn])
  @@map("solicitud_vinculacion_dispositivo")
}

model IncidenciaDispositivoProveedor {
  id String @id @default(uuid()) @db.Uuid

  cuentaId String @map("cuenta_id") @db.Uuid
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  /// Denormalizado para aplicar RLS sin joins.
  empresaRevendedoraId String             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  proveedorDeviceId   String                      @map("proveedor_device_id") @db.VarChar(60)
  mac                 String?                     @db.VarChar(40)
  tipoProveedor       String?                     @map("tipo_proveedor") @db.VarChar(40)
  estado              EstadoIncidenciaDispositivo @default(pendiente)
  cantidadDetecciones Int                         @default(1) @map("cantidad_detecciones")
  primeraDeteccionEn  DateTime                    @default(now()) @map("primera_deteccion_en")
  ultimaDeteccionEn   DateTime                    @default(now()) @map("ultima_deteccion_en")
  resueltaEn          DateTime?                   @map("resuelta_en")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([cuentaId, proveedorDeviceId])
  @@index([empresaRevendedoraId, estado])
  @@index([cuentaId, estado])
  @@map("incidencia_dispositivo_proveedor")
}

/// Login con permisos sobre alguno de los dos paneles. Pertenece a un único
/// tenant: o al Operador Principal, o a una Empresa Revendedora, nunca a ambos.
model TeamMember {
  id String @id @default(uuid()) @db.Uuid

  operadorPrincipalId String?            @map("operador_principal_id") @db.Uuid
  operadorPrincipal   OperadorPrincipal? @relation(fields: [operadorPrincipalId], references: [id], onDelete: Cascade)

  empresaRevendedoraId String?             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora? @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  /// Referencia al usuario en Auth0. La autenticación vive en Auth0; esta
  /// tabla sólo mapea ese usuario a un tenant y un rol dentro de IPTVControl.
  auth0UserId String? @unique @map("auth0_user_id") @db.VarChar(120)

  email  String           @unique @db.VarChar(160)
  nombre String?          @db.VarChar(120)
  rol    RolTeamMember
  estado EstadoTeamMember @default(invitado)

  ultimoAccesoEn DateTime? @map("ultimo_acceso_en")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  auditLogs                     AuditLog[]
  ventanasCuriosidadIniciadas   VentanaCuriosidad[] @relation("VentanaCuriosidadIniciadaPor")
  ventanasCuriosidadFinalizadas VentanaCuriosidad[] @relation("VentanaCuriosidadFinalizadaPor")
  plantillasWhatsAppActualizadas PlantillaWhatsApp[]  @relation("PlantillaWhatsAppActualizadaPor")

  @@index([empresaRevendedoraId])
  @@index([operadorPrincipalId])
  @@map("team_member")
}

/// Tabla de parametrización de modalidades y precios, gestionada por el
/// Operador Principal (reglas de negocio, sección 1).
model ModalidadComercial {
  id String @id @default(uuid()) @db.Uuid

  operadorPrincipalId String            @map("operador_principal_id") @db.Uuid
  operadorPrincipal   OperadorPrincipal @relation(fields: [operadorPrincipalId], references: [id], onDelete: Cascade)

  tipo ModalidadComercialTipo

  /// Escala: "X5", "X10" para obligación mensual; rango de volumen para
  /// menudeo (ej. "1-50").
  escala String @db.VarChar(40)

  /// Precio por Cuenta, parametrizable (sujeto a actualización por IPC).
  precioPorCuenta Decimal @map("precio_por_cuenta") @db.Decimal(12, 2)

  /// Para obligación mensual: cuánto crece el compromiso mensual acumulativo.
  ritmoIncremento Int? @map("ritmo_incremento")

  /// Tope de Cuentas activas habilitadas (parametrizable por el Operador
  /// Principal; null = sin tope explícito).
  topeCuentasActivas Int? @map("tope_cuentas_activas")

  vigenteDesde DateTime  @map("vigente_desde")
  vigenteHasta DateTime? @map("vigente_hasta")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresasRevendedoras EmpresaRevendedora[]

  @@index([operadorPrincipalId, tipo])
  @@map("modalidad_comercial")
}

/// Registro de auditoría (reglas de negocio, sección 11).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  teamMemberId String?     @map("team_member_id") @db.Uuid
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  /// Tenant del registro: permite que cada Empresa Revendedora vea sólo su
  /// propio log, y el Operador Principal el completo.
  empresaRevendedoraId String?             @map("empresa_revendedora_id") @db.Uuid
  empresaRevendedora   EmpresaRevendedora? @relation(fields: [empresaRevendedoraId], references: [id], onDelete: Cascade)

  operadorPrincipalId String?            @map("operador_principal_id") @db.Uuid
  operadorPrincipal   OperadorPrincipal? @relation(fields: [operadorPrincipalId], references: [id], onDelete: Cascade)

  accion          AccionAuditoria
  entidadAfectada EntidadAuditada @map("entidad_afectada")
  entidadId       String?         @map("entidad_id") @db.VarChar(60)

  /// Datos relevantes del cambio (ej. valores anterior/nuevo). Nunca debe
  /// incluir credenciales ni datos de contacto de Clientes Finales.
  detalle Json?

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([empresaRevendedoraId, creadoEn])
  @@index([accion, creadoEn])
  @@index([entidadAfectada, entidadId])
  @@map("audit_log")
}

/// Traza de llamadas a la API del Proveedor, para el panel de salud de la
/// integración del dashboard del Operador Principal (docs/04, sección 5).
model LlamadaProveedor {
  id String @id @default(uuid()) @db.Uuid

  operadorPrincipalId String?            @map("operador_principal_id") @db.Uuid
  operadorPrincipal   OperadorPrincipal? @relation(fields: [operadorPrincipalId], references: [id], onDelete: Cascade)

  operacion  String                 @db.VarChar(60)
  metodo     String                 @db.VarChar(10)
  ruta       String                 @db.VarChar(200)
  estado     EstadoLlamadaProveedor
  codigo     Int?
  duracionMs Int                    @map("duracion_ms")
  /// Mensaje técnico del error, sin credenciales.
  mensaje    String?                @db.VarChar(500)

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([creadoEn])
  @@index([estado, creadoEn])
  @@map("llamada_proveedor")
}
